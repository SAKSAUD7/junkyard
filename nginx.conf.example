# /etc/nginx/conf.d/junkyard.conf
# ─── JYNM Production Nginx Config — Fixed for SPA + correct MIME types ───────
#
# ROOT CAUSE FIX:
#   Previously, try_files fell through to @fallback for EVERY missing path,
#   including /assets/*.js requests. Nginx served index.html (text/html)
#   instead of a real 404, causing the browser's strict ESM loader to reject
#   the script → blank white page on /admin/login.
#
# FIX: Separate /assets/ location block that returns 404 for missing files.

server {
    listen 80;
    server_name 2.25.151.68 junkyardsnearme.com www.junkyardsnearme.com;

    # ── Frontend SPA root ────────────────────────────────────────────────────
    root /var/www/junkyard/frontend/dist;
    index index.html;

    # ── Static assets: JS/CSS/images — MUST return 404 for missing files ────
    # This block MUST come before the catch-all below.
    location /assets/ {
        # Immutable hashed assets — cache aggressively (filenames change on rebuild)
        add_header Cache-Control "public, max-age=31536000, immutable";
        # Do NOT fall through to SPA for missing asset files
        try_files $uri =404;
    }

    # ── Other static files (favicon, robots.txt, manifest, logos) ───────────
    location ~* \.(ico|png|jpg|jpeg|gif|svg|webp|woff|woff2|ttf|eot|pdf|txt|xml|json)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
        try_files $uri =404;
    }

    # ── SPA entry point — index.html must NOT be cached by browsers ──────────
    location / {
        # Never cache index.html so browsers always re-validate after a deploy
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        # React Router fallback: send all unmatched paths to index.html
        try_files $uri $uri/ /index.html;
    }

    # ── Django API reverse proxy ─────────────────────────────────────────────
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ── Django admin (if used) ───────────────────────────────────────────────
    location /django-admin/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
